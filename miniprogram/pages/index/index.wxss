.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ---- 顶栏 ---- */
.header {
  flex-shrink: 0;
}
.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding-left: 24rpx;
}
.brand { display: flex; align-items: center; flex: 1; min-width: 0; }
.brand-logo {
  width: 48rpx; height: 48rpx;
  background: #2b332d; color: #f5f3ec;
  font-size: 26rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  border-radius: 8rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.brand-text { display: flex; flex-direction: column; min-width: 0; }
.brand-name {
  font-size: 28rpx; font-weight: 600; color: #2b332d; letter-spacing: 1rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.brand-sub {
  font-size: 15rpx; color: #8a8d84; letter-spacing: 2rpx; text-transform: uppercase;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.header-actions { display: flex; align-items: center; gap: 10rpx; flex-shrink: 0; }
.hbtn {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 7rpx 13rpx; border-radius: 10rpx;
  background: rgba(255, 255, 255, .55);
  font-size: 21rpx; color: #4b4f49; line-height: 1.3;
  white-space: nowrap;
}
.hbtn-en { font-size: 15rpx; color: #9a9d94; }
.hbtn.primary { background: #3a3f3a; color: #f5f3ec; }
.hbtn.primary .hbtn-en { color: #b9bcb2; }

/* ---- 画布区 ---- */
.stage { flex: 1; min-height: 0; position: relative; overflow: hidden; }
.scene { position: absolute; left: 0; top: 0; }
.empty-hint {
  position: absolute; left: 0; right: 0; top: 18%;
  display: flex; flex-direction: column; align-items: center;
  pointer-events: none;
}
.hint-zh { font-size: 26rpx; color: #8f9289; letter-spacing: 2rpx; }
.hint-en { font-size: 18rpx; color: #a9aca2; margin-top: 6rpx; }
.stage-tools {
  position: absolute; left: 0; right: 0; bottom: 14rpx;
  display: flex; justify-content: space-between; align-items: flex-end;
  padding: 0 24rpx; pointer-events: none;
}
.tool-left { display: flex; gap: 24rpx; pointer-events: auto; }
.tool-link { font-size: 24rpx; color: #6d7068; }
.tool-link.disabled { color: #b4b7ad; }
.tool-right { display: flex; flex-direction: column; align-items: flex-end; }
.tool-right text:first-child { font-size: 22rpx; color: #8f9289; }
.count {
  position: absolute; top: 16rpx; right: 24rpx;
  font-size: 20rpx; color: #9a9d94; letter-spacing: 1rpx;
}

/* ---- 底部面板 ---- */
.panel {
  flex-shrink: 0;
  height: 520rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #f2f0e9;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 24rpx rgba(43, 51, 45, .08);
  padding-bottom: env(safe-area-inset-bottom);
}
.panel-tabs { flex-shrink: 0; display: flex; padding: 10rpx 24rpx 0; }
.ptab {
  display: flex; flex-direction: column; align-items: center;
  padding: 14rpx 30rpx 12rpx;
  font-size: 26rpx; color: #8a8d84; line-height: 1.3;
  border-bottom: 4rpx solid transparent;
}
.ptab-en { font-size: 16rpx; color: #a9aca2; }
.ptab.on { color: #2b332d; font-weight: 600; border-bottom-color: #2b332d; }
.ptab.on .ptab-en { color: #6d7068; }

.cats { flex-shrink: 0; display: flex; gap: 16rpx; padding: 18rpx 24rpx 6rpx; }
.cat {
  display: flex; flex-direction: column; align-items: center;
  padding: 10rpx 30rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, .7);
  font-size: 24rpx; color: #6d7068; line-height: 1.3;
}
.cat-en { font-size: 15rpx; color: #a9aca2; }
.cat.on { background: #3a3f3a; color: #f5f3ec; }
.cat.on .cat-en { color: #b9bcb2; }

.catalog {
  flex: 1;
  min-height: 0;
  white-space: nowrap;
  padding: 14rpx 12rpx 18rpx;
  box-sizing: border-box;
}
.card {
  position: relative;
  display: inline-flex; flex-direction: column; align-items: center;
  width: 168rpx; margin: 0 8rpx; padding: 16rpx 8rpx 12rpx;
  background: #fbfaf5; border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(43, 51, 45, .06);
  vertical-align: top;
}
.card-img { width: 148rpx; height: 168rpx; }
.card-name { font-size: 24rpx; color: #2b332d; margin-top: 8rpx; }
.card-en {
  font-size: 15rpx; color: #a9aca2; max-width: 152rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.card-add {
  position: absolute; top: 8rpx; right: 12rpx;
  font-size: 28rpx; color: #8a8d84;
}
.card:active { background: #f0eee5; }
.vase-card.on { box-shadow: 0 0 0 3rpx #3a3f3a inset; }

/* ---- 调整面板 ---- */
.adjust { flex: 1; min-height: 0; padding: 4rpx 24rpx 12rpx; box-sizing: border-box; }
.adjust-empty {
  flex: 1; min-height: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: #8a8d84; font-size: 26rpx; gap: 10rpx;
}
.ae-plus { font-size: 56rpx; color: #b4b7ad; }
.adj-head {
  display: flex; align-items: center; gap: 12rpx;
  padding: 10rpx 0 16rpx;
  border-bottom: 1rpx solid rgba(43, 51, 45, .08);
}
.adj-img { width: 88rpx; height: 88rpx; flex-shrink: 0; }
.adj-titles { flex: 1; display: flex; flex-direction: column; margin-left: 18rpx; min-width: 0; }
.adj-name { font-size: 30rpx; font-weight: 600; color: #2b332d; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.adj-en { font-size: 17rpx; color: #a9aca2; text-transform: uppercase; letter-spacing: 1rpx; }
.adj-btn {
  flex-shrink: 0;
  font-size: 22rpx; color: #4b4f49;
  padding: 8rpx 18rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, .7);
}
.adj-remove {
  flex-shrink: 0;
  font-size: 22rpx; color: #a3543f;
  padding: 8rpx 18rpx; border-radius: 999rpx;
  background: rgba(163, 84, 63, .1);
}
.adj-section { padding: 16rpx 0 4rpx; }
.adj-label { font-size: 22rpx; color: #6d7068; }
.adj-note { font-size: 22rpx; color: #a9aca2; margin-left: 12rpx; }
.swatches { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 12rpx 0 6rpx; }
.swatch {
  width: 50rpx; height: 50rpx; border-radius: 50%;
  box-sizing: border-box;
  border: 2rpx solid rgba(43, 51, 45, .14);
}
.swatch.on { border: 5rpx solid #3a3f3a; }
.slider-row { padding: 12rpx 0 4rpx; }
.slider-label { display: flex; justify-content: space-between; font-size: 22rpx; color: #6d7068; margin-bottom: 2rpx; }
.slider-val { color: #2b332d; }

/* ---- 容器面板 ---- */
.vase-colors {
  flex-shrink: 0;
  display: flex; align-items: center; gap: 14rpx;
  padding: 8rpx 24rpx 8rpx;
}
.vc-label { font-size: 22rpx; color: #6d7068; margin-right: 6rpx; }

/* ---- 完成作品 ---- */
.finish-mask {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(43, 51, 45, .55);
  display: flex; align-items: center; justify-content: center;
}
.finish-card {
  width: 620rpx; max-height: 84vh;
  background: #f5f3ec; border-radius: 20rpx; overflow: hidden;
  display: flex; flex-direction: column;
}
.finish-img { width: 100%; height: 780rpx; background: #d8d8d8; }
.finish-actions { display: flex; gap: 18rpx; padding: 22rpx; }
.fbtn {
  flex: 1; text-align: center;
  padding: 18rpx 0; border-radius: 999rpx;
  font-size: 26rpx; color: #4b4f49;
  background: rgba(255, 255, 255, .8);
}
.fbtn.primary { background: #3a3f3a; color: #f5f3ec; }
.finish-close {
  position: absolute; top: 90rpx; right: 40rpx;
  color: #f5f3ec; font-size: 40rpx; padding: 10rpx;
}
